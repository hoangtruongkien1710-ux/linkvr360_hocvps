# Copy this file to .env.production on the VPS and replace every placeholder.
# Do not commit .env.production.

DB_NAME=tour360
DB_USER=tour360
DB_PASSWORD=replace-with-a-long-random-password

# The hostname is the Compose service name, not localhost.
DATABASE_URL=postgresql://tour360:replace-with-a-long-random-password@db:5432/tour360

# Public URL used by the application when needed.
NEXT_PUBLIC_APP_URL=https://your-domain.example
