# Copy this file to .env.production on the VPS and replace every placeholder.
# Do not commit .env.production. No inline "#" comments after a value.

DB_NAME=tour360
DB_USER=tour360
# DB_PASSWORD and the password inside DATABASE_URL must be identical.
DB_PASSWORD=replace-with-a-long-random-password

# The hostname is the Compose service name (db), not localhost.
DATABASE_URL=postgresql://tour360:replace-with-a-long-random-password@db:5432/tour360

# Host port to reach the app at http://<server-ip>:<APP_PORT>
APP_PORT=8080

# Public URL of the app (used by the frontend when needed).
NEXT_PUBLIC_APP_URL=http://103.56.160.214:8080
